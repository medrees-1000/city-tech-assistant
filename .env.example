CTA_CONTACT_EMAIL=
# Phase 2 secrets (never commit .env)
OPENAI_API_KEY=
POSTGRES_PASSWORD=
# Optional overrides
DATABASE_URL=
CTA_EMBEDDING_MODEL=
CTA_CHAT_MODEL=
CTA_JUDGE_MODEL=
CTA_RERANK=
CTA_ROUTER_MODE=
CTA_ROUTER_SELECTOR=
CTA_ROUTER_CHAIN=
CTA_ROUTER_CONTACTS=
CTA_API_TODAY=

# Optional developer tracing with LangSmith (off by default; docs/decisions.md, "Near-miss floor and tracing").
# It is on only if tracing.enabled is true in config/models.yaml, CTA_TRACING is on AND the key is set, and only in
# the API. Keep LANGSMITH_TRACING=false: the API and the eval runners refuse to start if any tracing variable is on.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
CTA_TRACING=


# Behind the Vercel proxy (production only; leave empty for local development, where nothing changes).
# Generate each with: openssl rand -hex 32
# CTA_PROXY_SECRET: the API rejects requests without it (except GET /health) and then trusts x-real-ip.
# CTA_IP_SALT: the key of the HMAC-SHA256 that hashes the visitor address for the in-memory rate limit.
CTA_PROXY_SECRET=
CTA_IP_SALT=
# Login (Clerk), in web/.env.local for local runs and in the Vercel project settings (names only here).
# The API needs no Clerk key: it trusts x-cta-user only together with CTA_PROXY_SECRET.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: monthly spend cap in USD (default in config/models.yaml is 5.00)
CTA_MONTHLY_SPEND_CAP_USD=
