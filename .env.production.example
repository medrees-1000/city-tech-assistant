# Variables of the production stack (docker-compose.prod.yml). Copy to .env.production ON THE SERVER, fill the
# values there, chmod 600. Never commit it, never paste a value into a chat, a ticket or a screenshot.
# Every value is empty here on purpose. docs/deploy-runbook.md says how to make each one.

# -- the database --
POSTGRES_PASSWORD=
# -- the model provider: a NEW OpenAI project key used only here, with the project's $7 hard limit --
OPENAI_API_KEY=
# -- the public name of the server (the DuckDNS name; Caddy gets its certificate for it) --
CTA_HOSTNAME=
# -- behind the Vercel proxy: both are generated with `openssl rand -hex 32` --
CTA_PROXY_SECRET=
CTA_IP_SALT=
# -- the commit the image is built from (the runbook sets it from git before the build) --
CTA_COMMIT=
# -- tracing to LangSmith, on in production through these three; the file default stays off --
CTA_TRACING_ENABLED=
CTA_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# -- optional overrides of config/models.yaml (leave empty to use the file) --
CTA_MONTHLY_SPEND_CAP_USD=
CTA_DAILY_SPEND_CAP_USD=
CTA_RATE_PER_MINUTE=
CTA_RATE_PER_DAY=
# -- the kill switch: set to 1 and `docker compose up -d` to pause the assistant (the file data/api_disabled does the same without a restart) --
CTA_API_DISABLED=
